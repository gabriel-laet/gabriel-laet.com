---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { PROJECTS } from "../projects";

const essays = (await getCollection("essays", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const fmt = (d: Date) => d.toISOString().slice(0, 10);
---
<Base>
  <h1>Gabriel Laet</h1>
  <!-- TODO: bio -->
  <p class="muted">Bio coming soon.</p>

  <h2>Projects</h2>
  <ul class="list">
    {
      PROJECTS.map((p) => (
        <li>
          <a href={p.href}>{p.title}</a> <span class="mono muted">{p.year}</span>
          <div class="muted">{p.blurb}</div>
        </li>
      ))
    }
  </ul>

  <h2>Essays</h2>
  {
    essays.length ? (
      <ul class="list">
        {essays.map((e) => (
          <li>
            <a href={`/essays/${e.id}/`}>{e.data.title}</a> <span class="mono muted">{fmt(e.data.date)}</span>
            {e.data.summary && <div class="muted">{e.data.summary}</div>}
          </li>
        ))}
      </ul>
    ) : (
      <p class="muted">Soon.</p>
    )
  }
</Base>

<style>
  .list { list-style: none; padding: 0; margin: 0; }
  .list li { padding: 0.6rem 0; border-top: 1px solid var(--rule); }
  .list li:last-child { border-bottom: 1px solid var(--rule); }
</style>
